// XenosRecomp.exe's details and manifest in the Windows kit (tools/make_kit.sh).
1 24 "SSARecomp.manifest"

1 VERSIONINFO
FILEVERSION @PARTS@
PRODUCTVERSION @PARTS@
FILEOS 0x40004
FILETYPE 1
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"
        {
            VALUE "CompanyName", "Arkeyan project (kit distribution)"
            VALUE "LegalCopyright", "Copyright (c) 2025 hedge-dev and contributors; see licenses/"
            VALUE "FileDescription", "XenosRecomp shader translator in the Arkeyan player kit"
            VALUE "FileVersion", "@VERSION@"
            VALUE "InternalName", "XenosRecomp"
            VALUE "OriginalFilename", "XenosRecomp.exe"
            VALUE "ProductName", "Arkeyan player kit (XenosRecomp)"
            VALUE "ProductVersion", "@VERSION@"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 0x4B0
    }
}
