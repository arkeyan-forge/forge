#!/usr/bin/env bash
# Install once per clone: git config core.hooksPath tools/git-hooks
# Checks only the staged files: format, identity, no game data, no sign-off lines, no home paths.
fail() { echo "pre-commit: $1" >&2; exit 1; }

name=$(git config user.name); mail=$(git config user.email)
[ "$name <$mail>" = "mflr0 <mflr0@onionmail.org>" ] || fail "identity is '$name <$mail>', expected mflr0"

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

echo "$staged" | grep -qE '^private/|\.iso$|\.xex$|/ppc/|pipelines\.bin$|\.sky$|\.bin$' \
    && fail "game-derived file staged (private/, ISO, XEX, ppc/, pipelines, dumps)"

git diff --cached -U0 | grep -E '^\+' | grep -qE '/Users/[A-Za-z]|/home/[a-z]+/' \
    && fail "a home path is in the diff"

sources=$(echo "$staged" | grep -E '\.(cpp|h|hpp|mm|inc)$' | grep -vE '^(thirdparty|private|ArkeyanRecompLib|lib)/')
if [ -n "$sources" ]; then
    # The repository's one clang-format version (docs/CONVENTIONS.md, .github/workflows/ci.yml): the one on PATH, else
    # pip's user install (pip3 install --user clang-format==23.1.3 leaves another clang-format on PATH alone).
    want=23.1.3
    format=""
    for candidate in clang-format "$(python3 -I -m site --user-base 2>/dev/null)/bin/clang-format"; do
        "$candidate" --version 2>/dev/null | grep -qE "version $want( |\$)" && { format=$candidate; break; }
    done
    [ -n "$format" ] || fail "clang-format $want needed (pip3 install --user clang-format==$want)"
    bad=""
    for f in $sources; do
        git show ":$f" | "$format" --style=file --assume-filename="$f" | cmp -s - <(git show ":$f") 2>/dev/null \
            || bad="$bad $f"
    done
    [ -n "$bad" ] && fail "not formatted:$bad (run: $format -i$bad)"
fi
exit 0
