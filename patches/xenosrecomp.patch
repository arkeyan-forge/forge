+std::vector<uint8_t> ShaderRecompiler::synthesizeConstantTable() const
+{
+    struct Entry { std::string name; RegisterSet set; uint16_t index; uint16_t count; };
+    std::vector<Entry> entries{ { "g_C", RegisterSet::Float4, 0, uint16_t(isPixelShader ? 224 : 256) } };
+    for (uint16_t i = 0; i < 16; i++)
+    {
+        entries.push_back({ fmt::format("g_S{}", i), RegisterSet::Sampler, i, 1 });
+        entries.push_back({ fmt::format("g_B{}", i), RegisterSet::Bool, i, 1 });
+    }
+
+    // ConstantTableContainer: size, then the table; offsets inside are from the table (after the size).
+    constexpr uint32_t TableSize = 28, InfoSize = 20;
+    std::vector<uint8_t> data(4 + TableSize + entries.size() * InfoSize);
+    auto put32 = [&](size_t at, uint32_t v) { for (int i = 0; i < 4; i++) data[at + i] = uint8_t(v >> (24 - 8 * i)); };
+    auto put16 = [&](size_t at, uint16_t v) { data[at] = uint8_t(v >> 8); data[at + 1] = uint8_t(v); };
+    put32(4 + 12, uint32_t(entries.size()));
+    put32(4 + 16, TableSize);
+    for (size_t i = 0; i < entries.size(); i++)
+    {
+        size_t info = 4 + TableSize + i * InfoSize;
+        put32(info, uint32_t(data.size() - 4));
+        data.insert(data.end(), entries[i].name.begin(), entries[i].name.end());
+        data.push_back(0);
+        put16(info + 4, uint16_t(entries[i].set));
+        put16(info + 6, entries[i].index);
+        put16(info + 8, entries[i].count);
+    }
+    put32(0, uint32_t(data.size()));
+    put32(4, uint32_t(data.size() - 4));
+    return data;
+}
