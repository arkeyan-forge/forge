diff --git a/XenonRecomp/recompiler_750cl.inl b/XenonRecomp/recompiler_750cl.inl
new file mode 100644
index 0000000..a934377
--- /dev/null
+++ b/XenonRecomp/recompiler_750cl.inl
@@ -0,0 +1,300 @@
+// The 750CL's instructions (the Wii's Broadway, the GameCube's Gekko), included in Recompiler::Recompile's switch,
+// whose register formatters (r, f, cr) and locals (ea, temp) they use; on with the config's paired_singles. Written
+// from IBM's PowerPC 750CL User's Manual.
+//
+// Each FPR holds two values: ps0, the FPR itself (f0-f31, a double), and ps1, a single (ctx.ps1). The paired-single
+// instructions work on both, each result rounded to a single; ps0 alone is what every other float instruction uses
+// (single-precision results and lfs fill both halves: see the end of Recompile). The quantized loads and stores
+// convert through a GQR (ctx.gqr, PPCLoadPaired and PPCStorePaired in ppc_context.h).
+
+#define PS_HALF(index, lane) ((lane) == 0 ? fmt::format("{}.f64", f(index)) : fmt::format("ctx.ps1[{}]", index))
+
+    case PPC_INST_PS_ADD:
+    case PPC_INST_PS_SUB:
+    case PPC_INST_PS_MUL:
+    case PPC_INST_PS_DIV:
+    case PPC_INST_PS_MADD:
+    case PPC_INST_PS_MSUB:
+    case PPC_INST_PS_NMADD:
+    case PPC_INST_PS_NMSUB:
+    case PPC_INST_PS_MULS0:
+    case PPC_INST_PS_MULS1:
+    case PPC_INST_PS_MADDS0:
+    case PPC_INST_PS_MADDS1:
+    case PPC_INST_PS_SEL:
+    case PPC_INST_PS_RES:
+    case PPC_INST_PS_RSQRTE:
+    {
+        if (!config.pairedSingles)
+            return false;
+        printSetFlushMode(false);
+        // Operands: d, a, b (add, sub, div); d, a, c (mul, muls); d, a, c, b (the multiply-adds, sel); d, b (res,
+        // rsqrte). The scalar forms (muls0, madds1...) take c's lane 0 or 1 for both lanes.
+        const uint32_t d = insn.operands[0];
+        std::string lanes[2];
+        for (int lane = 0; lane < 2; lane++)
+        {
+            // Formatted only when used: formatting a register marks it as one of the function's locals.
+            auto a = [&]() { return PS_HALF(insn.operands[1], lane); };
+            auto second = [&]() { return PS_HALF(insn.operands[2], lane); };
+            auto c = [&](int fixed) { return PS_HALF(insn.operands[2], fixed); };
+            auto b = [&]() { return PS_HALF(insn.operands[3], lane); };
+            std::string& value = lanes[lane];
+            switch (insn.opcode->id)
+            {
+            case PPC_INST_PS_ADD: value = fmt::format("{} + {}", a(), second()); break;
+            case PPC_INST_PS_SUB: value = fmt::format("{} - {}", a(), second()); break;
+            case PPC_INST_PS_MUL: value = fmt::format("{} * {}", a(), second()); break;
+            case PPC_INST_PS_DIV: value = fmt::format("{} / {}", a(), second()); break;
+            case PPC_INST_PS_MADD: value = fmt::format("{} * {} + {}", a(), second(), b()); break;
+            case PPC_INST_PS_MSUB: value = fmt::format("{} * {} - {}", a(), second(), b()); break;
+            case PPC_INST_PS_NMADD: value = fmt::format("-({} * {} + {})", a(), second(), b()); break;
+            case PPC_INST_PS_NMSUB: value = fmt::format("-({} * {} - {})", a(), second(), b()); break;
+            case PPC_INST_PS_MULS0: value = fmt::format("{} * {}", a(), c(0)); break;
+            case PPC_INST_PS_MULS1: value = fmt::format("{} * {}", a(), c(1)); break;
+            case PPC_INST_PS_MADDS0: value = fmt::format("{} * {} + {}", a(), c(0), b()); break;
+            case PPC_INST_PS_MADDS1: value = fmt::format("{} * {} + {}", a(), c(1), b()); break;
+            // Lane by lane: c when a is at least zero (-0 included), else b, a NaN choosing b.
+            case PPC_INST_PS_SEL: value = fmt::format("{} >= 0.0 ? {} : {}", a(), second(), b()); break;
+            case PPC_INST_PS_RES: value = fmt::format("1.0 / {}", a()); break;
+            case PPC_INST_PS_RSQRTE: value = fmt::format("1.0 / sqrt({})", a()); break;
+            }
+        }
+        // Both lanes are computed before either is written: d may be a source.
+        println("\t{{ const double ps0 = float({}), ps1 = float({}); {} = ps0; {} = ps1; }}", lanes[0], lanes[1],
+            PS_HALF(d, 0), PS_HALF(d, 1));
+        break;
+    }
+
+    // ps_sum0: d0 = a0 + b1, d1 = c1. ps_sum1: d0 = c0, d1 = a0 + b1. Operands d, a, c, b.
+    case PPC_INST_PS_SUM0:
+    case PPC_INST_PS_SUM1:
+    {
+        if (!config.pairedSingles)
+            return false;
+        printSetFlushMode(false);
+        const uint32_t d = insn.operands[0], a = insn.operands[1], c = insn.operands[2], b = insn.operands[3];
+        const auto sum = fmt::format("float({} + {})", PS_HALF(a, 0), PS_HALF(b, 1));
+        if (insn.opcode->id == PPC_INST_PS_SUM0)
+            println("\t{{ const double ps0 = {}, ps1 = float({}); {} = ps0; {} = ps1; }}", sum, PS_HALF(c, 1),
+                PS_HALF(d, 0), PS_HALF(d, 1));
+        else
+            println("\t{{ const double ps0 = {}, ps1 = {}; {} = ps0; {} = ps1; }}", PS_HALF(c, 0), sum, PS_HALF(d, 0),
+                PS_HALF(d, 1));
+        break;
+    }
+
+    // Sign and copy, lane by lane, no rounding. Operands d, b.
+    case PPC_INST_PS_NEG:
+    case PPC_INST_PS_ABS:
+    case PPC_INST_PS_NABS:
+    case PPC_INST_PS_MR:
+    {
+        if (!config.pairedSingles)
+            return false;
+        printSetFlushMode(false);
+        const char* form = insn.opcode->id == PPC_INST_PS_NEG ? "-{}"
+            : insn.opcode->id == PPC_INST_PS_ABS              ? "fabs({})"
+            : insn.opcode->id == PPC_INST_PS_NABS             ? "-fabs({})"
+                                                              : "{}";
+        const uint32_t d = insn.operands[0], b = insn.operands[1];
+        println("\t{{ const double ps0 = {}, ps1 = {}; {} = ps0; {} = ps1; }}",
+            fmt::format(fmt::runtime(form), PS_HALF(b, 0)), fmt::format(fmt::runtime(form), PS_HALF(b, 1)),
+            PS_HALF(d, 0), PS_HALF(d, 1));
+        break;
+    }
+
+    // ps_mergeXY: d0 = a's lane X, d1 = b's lane Y (held as a single). Operands d, a, b.
+    case PPC_INST_PS_MERGE00:
+    case PPC_INST_PS_MERGE01:
+    case PPC_INST_PS_MERGE10:
+    case PPC_INST_PS_MERGE11:
+    {
+        if (!config.pairedSingles)
+            return false;
+        printSetFlushMode(false);
+        const int id = insn.opcode->id;
+        const int x = id == PPC_INST_PS_MERGE10 || id == PPC_INST_PS_MERGE11;
+        const int y = id == PPC_INST_PS_MERGE01 || id == PPC_INST_PS_MERGE11;
+        const uint32_t d = insn.operands[0], a = insn.operands[1], b = insn.operands[2];
+        println("\t{{ const double ps0 = {}, ps1 = float({}); {} = ps0; {} = ps1; }}", PS_HALF(a, x), PS_HALF(b, y),
+            PS_HALF(d, 0), PS_HALF(d, 1));
+        break;
+    }
+
+    // Operands crfD, a, b: lane 0 (cmpu0, cmpo0) or lane 1.
+    case PPC_INST_PS_CMPU0:
+    case PPC_INST_PS_CMPO0:
+    case PPC_INST_PS_CMPU1:
+    case PPC_INST_PS_CMPO1:
+    {
+        if (!config.pairedSingles)
+            return false;
+        printSetFlushMode(false);
+        const int lane = insn.opcode->id == PPC_INST_PS_CMPU1 || insn.opcode->id == PPC_INST_PS_CMPO1;
+        println("\t{}.compare({}, {});", cr(insn.operands[0]), PS_HALF(insn.operands[1], lane),
+            PS_HALF(insn.operands[2], lane));
+        break;
+    }
+
+    // psq_l, psq_lu, psq_st, psq_stu: d, displacement, rA, W, I. The indexed forms: d, rA, rB, W, I. The update forms
+    // write the address back to rA.
+    case PPC_INST_PSQ_L:
+    case PPC_INST_PSQ_LU:
+    case PPC_INST_PSQ_LX:
+    case PPC_INST_PSQ_LUX:
+    case PPC_INST_PSQ_ST:
+    case PPC_INST_PSQ_STU:
+    case PPC_INST_PSQ_STX:
+    case PPC_INST_PSQ_STUX:
+    {
+        if (!config.pairedSingles)
+            return false;
+        printSetFlushMode(false);
+        const int id = insn.opcode->id;
+        const bool indexed = id == PPC_INST_PSQ_LX || id == PPC_INST_PSQ_LUX || id == PPC_INST_PSQ_STX ||
+            id == PPC_INST_PSQ_STUX;
+        const bool update = id == PPC_INST_PSQ_LU || id == PPC_INST_PSQ_LUX || id == PPC_INST_PSQ_STU ||
+            id == PPC_INST_PSQ_STUX;
+        const bool load = id == PPC_INST_PSQ_L || id == PPC_INST_PSQ_LU || id == PPC_INST_PSQ_LX ||
+            id == PPC_INST_PSQ_LUX;
+        const uint32_t d = insn.operands[0], w = insn.operands[3], i = insn.operands[4];
+        const uint32_t ra = indexed ? insn.operands[1] : insn.operands[2];
+        const auto offset = indexed ? fmt::format("{}.u32", r(insn.operands[2]))
+                                    : fmt::format("{}", int32_t(insn.operands[1]));
+        if (ra != 0)
+            println("\t{} = {}.u32 + {};", ea(), r(ra), offset);
+        else
+            println("\t{} = {};", ea(), offset);
+        if (load)
+            println("\tPPCLoadPaired(base, {}, ctx.gqr[{}], {}, {}, {});", ea(), i, w != 0 ? "true" : "false",
+                PS_HALF(d, 0), PS_HALF(d, 1));
+        else
+            println("\tPPCStorePaired(base, {}, ctx.gqr[{}], {}, {}, {});", ea(), i, w != 0 ? "true" : "false",
+                PS_HALF(d, 0), PS_HALF(d, 1));
+        if (update)
+            println("\t{}.u32 = {};", r(ra), ea());
+        break;
+    }
+
+    // dcbz_l rA, rB: zeroes a line of the locked cache, 32 bytes.
+    case PPC_INST_DCBZ_L:
+        if (!config.pairedSingles)
+            return false;
+        print("\tmemset(base + ((");
+        if (insn.operands[0] != 0)
+            print("{}.u32 + ", r(insn.operands[0]));
+        println("{}.u32) & ~31), 0, 32);", r(insn.operands[1]));
+        break;
+
+    // The GQRs, SPRs 912-919; any other SPR is left to the caller (not translated).
+    case PPC_INST_MTSPR:
+        if (!config.pairedSingles || insn.operands[0] < 912 || insn.operands[0] > 919)
+            return false;
+        println("\tctx.gqr[{}] = {}.u32;", insn.operands[0] - 912, r(insn.operands[1]));
+        break;
+
+    case PPC_INST_MFSPR:
+        if (!config.pairedSingles || insn.operands[1] < 912 || insn.operands[1] > 919)
+            return false;
+        println("\t{}.u64 = ctx.gqr[{}];", r(insn.operands[0]), insn.operands[1] - 912);
+        break;
+
+    // lmw, stmw rT, d(rA): rT to r31, a word each, as the 750CL's compilers save and restore registers.
+    case PPC_INST_LMW:
+    case PPC_INST_STMW:
+    {
+        const uint32_t first = insn.operands[0], ra = insn.operands[2];
+        if (ra != 0)
+            println("\t{} = {}.u32 + {};", ea(), r(ra), int32_t(insn.operands[1]));
+        else
+            println("\t{} = {};", ea(), int32_t(insn.operands[1]));
+        for (uint32_t reg = first; reg < 32; reg++)
+        {
+            if (insn.opcode->id == PPC_INST_LMW)
+                println("\t{}.u64 = PPC_LOAD_U32({} + {});", r(reg), ea(), (reg - first) * 4);
+            else
+                println("\tPPC_STORE_U32({} + {}, {}.u32);", ea(), (reg - first) * 4, r(reg));
+        }
+        break;
+    }
+
+    // PowerPC instructions the Xbox 360's compilers left out and the 750CL's use: any config.
+
+    // fcmpo: as fcmpu; the two differ only in the exceptions an invalid operand raises, which nothing here enables.
+    case PPC_INST_FCMPO:
+        printSetFlushMode(false);
+        println("\t{}.compare({}.f64, {}.f64);", cr(insn.operands[0]), f(insn.operands[1]), f(insn.operands[2]));
+        break;
+
+    // The condition register's logical instructions: BT, BA, BB, by bit (bit 4n+k is field n's lt, gt, eq, so). crclr,
+    // crset, crnot and crmove are their extended forms, with BA and BB hidden.
+    case PPC_INST_CRAND:
+    case PPC_INST_CROR:
+    case PPC_INST_CRXOR:
+    case PPC_INST_CRNAND:
+    case PPC_INST_CRNOR:
+    case PPC_INST_CREQV:
+    case PPC_INST_CRANDC:
+    case PPC_INST_CRORC:
+    case PPC_INST_CRNOT:
+    case PPC_INST_CRMOVE:
+    case PPC_INST_CRCLR:
+    case PPC_INST_CRSET:
+    {
+        auto bit = [&](uint32_t index) {
+            constexpr const char* names[] = { "lt", "gt", "eq", "so" };
+            return fmt::format("{}.{}", cr(index / 4), names[index % 4]);
+        };
+        const char* form = nullptr;
+        switch (insn.opcode->id)
+        {
+        case PPC_INST_CRAND: form = "{} & {}"; break;
+        case PPC_INST_CROR: form = "{} | {}"; break;
+        case PPC_INST_CRXOR: form = "{} ^ {}"; break;
+        case PPC_INST_CRNAND: form = "!({} & {})"; break;
+        case PPC_INST_CRNOR: form = "!({} | {})"; break;
+        case PPC_INST_CREQV: form = "!({} ^ {})"; break;
+        case PPC_INST_CRANDC: form = "{} & !{}"; break;
+        case PPC_INST_CRORC: form = "{} | !{}"; break;
+        }
+        std::string value;
+        if (insn.opcode->id == PPC_INST_CRCLR)
+            value = "0";
+        else if (insn.opcode->id == PPC_INST_CRSET)
+            value = "1";
+        else if (insn.opcode->id == PPC_INST_CRNOT)
+            value = fmt::format("!{}", bit(insn.operands[1]));
+        else if (insn.opcode->id == PPC_INST_CRMOVE)
+            value = bit(insn.operands[1]);
+        else
+            value = fmt::format(fmt::runtime(form), bit(insn.operands[1]), bit(insn.operands[2]));
+        println("\t{} = {};", bit(insn.operands[0]), value);
+        break;
+    }
+
+    // rlwnm rA, rS, rB, MB, ME: rotlw by rB's low five bits, then the mask, as rlwinm.
+    case PPC_INST_RLWNM:
+        println("\t{}.u64 = __builtin_rotateleft64({}.u32 | ({}.u64 << 32), {}.u8 & 0x1F) & 0x{:X};",
+            r(insn.operands[0]), r(insn.operands[1]), r(insn.operands[1]), r(insn.operands[2]),
+            ComputeMask(insn.operands[3] + 32, insn.operands[4] + 32));
+        if (strchr(insn.opcode->name, '.'))
+            println("\t{}.compare<int32_t>({}.s32, 0, {});", cr(0), r(insn.operands[0]), xer());
+        break;
+
+    case PPC_INST_MFCTR:
+        println("\t{}.u64 = {}.u64;", r(insn.operands[0]), ctr());
+        break;
+
+    case PPC_INST_MFXER:
+        println("\t{0}.u64 = ({1}.so ? 0x80000000u : 0) | ({1}.ov ? 0x40000000u : 0) | ({1}.ca ? 0x20000000u : 0);",
+            r(insn.operands[0]), xer());
+        break;
+
+    // Instruction-cache and context barriers, and the data-cache invalidate: no effect on a host's memory.
+    case PPC_INST_ISYNC:
+    case PPC_INST_ICBI:
+    case PPC_INST_DCBI:
+        break;
+
+#undef PS_HALF
