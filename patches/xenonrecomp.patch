+inline double PPCDequantize(uint8_t* base, uint32_t ea, uint32_t type, int scale)
+{
+    PPCRegister temp;
+    switch (type)
+    {
+    case 4: return double(PPC_LOAD_U8(ea)) * PPCPowerOfTwo(-scale);
+    case 5: return double(PPC_LOAD_U16(ea)) * PPCPowerOfTwo(-scale);
+    case 6: return double(int8_t(PPC_LOAD_U8(ea))) * PPCPowerOfTwo(-scale);
+    case 7: return double(int16_t(PPC_LOAD_U16(ea))) * PPCPowerOfTwo(-scale);
+    default: temp.u32 = PPC_LOAD_U32(ea); return double(temp.f32);
+    }
+}
+
+inline void PPCQuantize(uint8_t* base, uint32_t ea, uint32_t type, int scale, double value)
+{
+    PPCRegister temp;
+    if (type < 4)
