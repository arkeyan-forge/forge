+    const double low = type == 6 ? -128.0 : type == 7 ? -32768.0 : 0.0;
+    const double high = type == 4 ? 255.0 : type == 5 ? 65535.0 : type == 6 ? 127.0 : 32767.0;
+    const double scaled = double(float(value)) * PPCPowerOfTwo(scale);
+    const int32_t integer = scaled != scaled ? 0 : scaled < low ? int32_t(low) : scaled > high ? int32_t(high) : int32_t(scaled);
