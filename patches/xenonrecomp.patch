+// 2^scale when loaded and multiplied by it, then saturated, when stored. W set: one value, and ps1 is 1.0.
+inline uint32_t PPCQuantizedSize(uint32_t type)
+{
+    return type < 4 ? 4 : (type & 1) ? 2 : 1;
