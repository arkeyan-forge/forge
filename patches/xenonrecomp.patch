+
+inline double PPCPowerOfTwo(int exponent) // -32 to 31, a float's normal range
+{
+    uint32_t bits = uint32_t(127 + exponent) << 23;
+    float value;
+    memcpy(&value, &bits, sizeof(value));
+    return value;
+}
