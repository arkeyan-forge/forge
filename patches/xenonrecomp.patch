+#pragma once
+
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include "recompiler_config.h"
+
+namespace RecompilerHeaders
+{
+    // Shared with translation: this prefix contains only public policy, in its original order.
+    inline std::string ConfigPrefix(const RecompilerConfig& config)
+    {
+        std::string out = "#pragma once\n#ifndef PPC_CONFIG_H_INCLUDED\n#define PPC_CONFIG_H_INCLUDED\n\n";
+        if (config.skipLr)
+            out += "#define PPC_CONFIG_SKIP_LR\n";
+        if (config.ctrAsLocalVariable)
+            out += "#define PPC_CONFIG_CTR_AS_LOCAL\n";
+        if (config.xerAsLocalVariable)
+            out += "#define PPC_CONFIG_XER_AS_LOCAL\n";
+        if (config.reservedRegisterAsLocalVariable)
+            out += "#define PPC_CONFIG_RESERVED_AS_LOCAL\n";
+        if (config.skipMsr)
+            out += "#define PPC_CONFIG_SKIP_MSR\n";
+        if (config.crRegistersAsLocalVariables)
+            out += "#define PPC_CONFIG_CR_AS_LOCAL\n";
+        if (config.nonArgumentRegistersAsLocalVariables)
+            out += "#define PPC_CONFIG_NON_ARGUMENT_AS_LOCAL\n";
+        if (config.nonVolatileRegistersAsLocalVariables)
+            out += "#define PPC_CONFIG_NON_VOLATILE_AS_LOCAL\n";
+        if (config.pairedSingles)
+            out += "#define PPC_CONFIG_PAIRED_SINGLES\n";
+
+        out += '\n';
+        return out;
+    }
+
+    inline std::string Context(const std::filesystem::path& headerFilePath)
+    {
+        std::string out = "#pragma once\n#include \"ppc_config.h\"\n\n";
+        std::ifstream stream(headerFilePath);
+        if (stream.good())
+        {
+            std::stringstream ss;
+            ss << stream.rdbuf();
+            out += ss.str();
+        }
+        return out;
+    }
+}
