+
+    bool D3D12SwapChain::getDisplayStats(RenderDisplayStats &stats) const {
+        DXGI_FRAME_STATISTICS statistics = {};
+        if ((d3d == nullptr) || FAILED(d3d->GetFrameStatistics(&statistics))) {
+            return false;
+        }
+
+        stats.frames = statistics.PresentCount;
+        stats.refreshes = statistics.PresentRefreshCount;
+        stats.timeNs = 0;
+        return true;
+    }
