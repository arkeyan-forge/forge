+uint32_t Recompiler::GatherRegisters(const Function& fn)
+{
+    // The registers that hold the pipe's address anywhere in the function: set by lis to its upper half (what the
+    // SDK's inline GX writes compile to, the store's displacement then reaching it), or copied from one by mr, addi or
+    // addis. Flow-insensitive: a register that also holds other addresses elsewhere only makes those stores checked.
+    if (config.writeGatherPipe == 0)
+        return 0;
+    const auto* words = (const uint32_t*)image.Find(fn.base);
+    if (words == nullptr)
+        return 0;
+    uint32_t set = 0;
+    for (bool grew = true; grew;)
+    {
+        grew = false;
+        for (size_t at = 0; at < fn.size / 4; at++)
+        {
+            ppc_insn insn;
+            ppc::Disassemble(words + at, 4, fn.base + at * 4, insn);
+            if (insn.opcode == nullptr || insn.operands[0] >= 32)
+                continue;
+            const uint32_t d = insn.operands[0];
+            bool points = false;
+            switch (insn.opcode->id)
+            {
+            case PPC_INST_LIS:
+            {
+                const int64_t high = int64_t(int32_t(insn.operands[1] << 16));
+                const int64_t pipe = int64_t(int32_t(config.writeGatherPipe));
+                points = pipe - high >= -0x8000 && pipe - high < 0x8000;
+                break;
+            }
+            case PPC_INST_MR:
+            case PPC_INST_ADDI:
+            case PPC_INST_ADDIS:
+                points = insn.operands[1] < 32 && (set >> insn.operands[1] & 1) != 0;
+                break;
+            }
+            if (points && (set >> d & 1) == 0)
+            {
+                set |= 1u << d;
+                grew = true;
+            }
+        }
+    }
+    return set;
+}
+
 bool Recompiler::Recompile(const Function& fn)
 {
     auto base = fn.base;
     auto end = base + fn.size;
     auto* data = (uint32_t*)image.Find(base);
+    gatherRegisters = GatherRegisters(fn);
 
     static std::unordered_set<size_t> labels;
     labels.clear();
